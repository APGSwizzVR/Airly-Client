{"data":{"stdout":"<Window x:Class=\"AirlyClient.MainWindow\" Icon=\"Assets/Airly.ico\"\n        xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\n        xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\n        Title=\"Airly Client\" Width=\"1320\" Height=\"820\"\n        MinWidth=\"1120\" MinHeight=\"700\" WindowStartupLocation=\"CenterScreen\"\n        Background=\"{DynamicResource WindowBrush}\" Foreground=\"{DynamicResource TextBrush}\">\n    <Window.Resources>\n        <SolidColorBrush x:Key=\"WindowBrush\" Color=\"#0A0D11\"/>\n        <SolidColorBrush x:Key=\"SidebarBrush\" Color=\"#080B0F\"/>\n        <SolidColorBrush x:Key=\"GlassBrush\" Color=\"#12171D\"/>\n        <SolidColorBrush x:Key=\"PanelBrush\" Color=\"#151B22\"/>\n        <SolidColorBrush x:Key=\"InputBrush\" Color=\"#0E1318\"/>\n        <SolidColorBrush x:Key=\"LineBrush\" Color=\"#27303A\"/>\n        <SolidColorBrush x:Key=\"TextBrush\" Color=\"#F2F5F7\"/>\n        <SolidColorBrush x:Key=\"MutedBrush\" Color=\"#9BA7B1\"/>\n        <SolidColorBrush x:Key=\"AccentBrush\" Color=\"#8A96A3\"/>\n        <SolidColorBrush x:Key=\"AccentSoftBrush\" Color=\"#26313B\"/>\n        <SolidColorBrush x:Key=\"SuccessBrush\" Color=\"#62C995\"/>\n        <SolidColorBrush x:Key=\"DangerBrush\" Color=\"#E68181\"/>\n        <Style x:Key=\"NavButton\" TargetType=\"Button\"><Setter Property=\"Background\" Value=\"Transparent\"/><Setter Property=\"Foreground\" Value=\"{DynamicResource MutedBrush}\"/><Setter Property=\"BorderBrush\" Value=\"Transparent\"/><Setter Property=\"BorderThickness\" Value=\"1\"/><Setter Property=\"HorizontalContentAlignment\" Value=\"Left\"/><Setter Property=\"Padding\" Value=\"14,11\"/><Setter Property=\"Margin\" Value=\"0,2\"/><Setter Property=\"FontSize\" Value=\"13\"/><Setter Property=\"Cursor\" Value=\"Hand\"/><Style.Triggers><Trigger Property=\"IsMouseOver\" Value=\"True\"><Setter Property=\"Background\" Value=\"{DynamicResource AccentSoftBrush}\"/><Setter Property=\"Foreground\" Value=\"{DynamicResource TextBrush}\"/><Setter Property=\"BorderBrush\" Value=\"{DynamicResource LineBrush}\"/></Trigger></Style.Triggers></Style>\n        <Style x:Key=\"PrimaryButton\" TargetType=\"Button\"><Setter Property=\"Background\" Value=\"{DynamicResource AccentBrush}\"/><Setter Property=\"Foreground\" Value=\"#FFFFFF\"/><Setter Property=\"BorderThickness\" Value=\"0\"/><Setter Property=\"Padding\" Value=\"16,10\"/><Setter Property=\"FontWeight\" Value=\"SemiBold\"/><Setter Property=\"Cursor\" Value=\"Hand\"/><Style.Triggers><Trigger Property=\"IsMouseOver\" Value=\"True\"><Setter Property=\"Opacity\" Value=\"0.86\"/></Trigger></Style.Triggers></Style>\n        <Style x:Key=\"SecondaryButton\" TargetType=\"Button\"><Setter Property=\"Background\" Value=\"{DynamicResource GlassBrush}\"/><Setter Property=\"Foreground\" Value=\"{DynamicResource TextBrush}\"/><Setter Property=\"BorderBrush\" Value=\"{DynamicResource LineBrush}\"/><Setter Property=\"BorderThickness\" Value=\"1\"/><Setter Property=\"Padding\" Value=\"14,10\"/><Setter Property=\"Cursor\" Value=\"Hand\"/></Style>\n        <Style x:Key=\"Card\" TargetType=\"Border\"><Setter Property=\"Background\" Value=\"{DynamicResource PanelBrush}\"/><Setter Property=\"BorderBrush\" Value=\"{DynamicResource LineBrush}\"/><Setter Property=\"BorderThickness\" Value=\"1\"/><Setter Property=\"CornerRadius\" Value=\"14\"/><Setter Property=\"Padding\" Value=\"18\"/></Style>\n        <Style x:Key=\"SectionTitle\" TargetType=\"TextBlock\"><Setter Property=\"FontSize\" Value=\"19\"/><Setter Property=\"FontWeight\" Value=\"SemiBold\"/><Setter Property=\"Foreground\" Value=\"{DynamicResource TextBrush}\"/></Style>\n        <Style x:Key=\"FieldLabel\" TargetType=\"TextBlock\"><Setter Property=\"FontSize\" Value=\"11\"/><Setter Property=\"FontWeight\" Value=\"SemiBold\"/><Setter Property=\"Foreground\" Value=\"{DynamicResource MutedBrush}\"/><Setter Property=\"Margin\" Value=\"0,14,0,6\"/></Style>\n        <Style TargetType=\"TextBox\"><Setter Property=\"Background\" Value=\"{DynamicResource InputBrush}\"/><Setter Property=\"Foreground\" Value=\"{DynamicResource TextBrush}\"/><Setter Property=\"BorderBrush\" Value=\"{DynamicResource LineBrush}\"/><Setter Property=\"Padding\" Value=\"10,7\"/></Style>\n        <Style TargetType=\"ComboBox\"><Setter Property=\"Background\" Value=\"{DynamicResource InputBrush}\"/><Setter Property=\"Foreground\" Value=\"{DynamicResource TextBrush}\"/><Setter Property=\"BorderBrush\" Value=\"{DynamicResource LineBrush}\"/></Style>\n        <Style TargetType=\"CheckBox\"><Setter Property=\"Foreground\" Value=\"{DynamicResource TextBrush}\"/><Setter Property=\"Margin\" Value=\"0,10,0,0\"/></Style>\n        <Style TargetType=\"DataGrid\"><Setter Property=\"Background\" Value=\"{DynamicResource InputBrush}\"/><Setter Property=\"Foreground\" Value=\"{DynamicResource TextBrush}\"/><Setter Property=\"BorderBrush\" Value=\"{DynamicResource LineBrush}\"/><Setter Property=\"RowBackground\" Value=\"{DynamicResource PanelBrush}\"/><Setter Property=\"AlternatingRowBackground\" Value=\"{DynamicResource InputBrush}\"/><Setter Property=\"GridLinesVisibility\" Value=\"Horizontal\"/><Setter Property=\"FontSize\" Value=\"12\"/></Style>\n        <Style TargetType=\"DataGridColumnHeader\"><Setter Property=\"Background\" Value=\"{DynamicResource GlassBrush}\"/><Setter Property=\"Foreground\" Value=\"{DynamicResource MutedBrush}\"/><Setter Property=\"FontWeight\" Value=\"SemiBold\"/><Setter Property=\"Padding\" Value=\"9,8\"/></Style>\n    </Window.Resources>\n    <Grid>\n        <Grid.ColumnDefinitions><ColumnDefinition Width=\"230\"/><ColumnDefinition Width=\"*\"/></Grid.ColumnDefinitions>\n        <Border Grid.Column=\"0\" Background=\"{DynamicResource SidebarBrush}\" BorderBrush=\"{DynamicResource LineBrush}\" BorderThickness=\"0,0,1,0\">\n            <DockPanel Margin=\"16,18\">\n                <StackPanel DockPanel.Dock=\"Top\">\n                    <TextBlock Text=\"AIRLY\" FontSize=\"19\" FontWeight=\"Bold\" Foreground=\"{DynamicResource TextBrush}\"/>\n                    <TextBlock Text=\"FLIGHT NETWORK CLIENT\" FontSize=\"9\" FontWeight=\"SemiBold\" Foreground=\"{DynamicResource MutedBrush}\" Margin=\"0,3,0,22\"/>\n                    <TextBlock Text=\"FLIGHT DECK\" FontSize=\"9\" FontWeight=\"Bold\" Foreground=\"{DynamicResource MutedBrush}\" Margin=\"4,0,0,5\"/>\n                    <Button Content=\"Overview\" Tag=\"Dashboard\" Click=\"Nav_Click\" Style=\"{StaticResource NavButton}\"/>\n                    <Button Content=\"Connect\" Tag=\"Connect\" Click=\"Nav_Click\" Style=\"{StaticResource NavButton}\"/>\n                    <Button Content=\"Traffic\" Tag=\"Traffic\" Click=\"Nav_Click\" Style=\"{StaticResource NavButton}\"/>\n                    <Button Content=\"Track Flights\" Tag=\"Tracking\" Click=\"Nav_Click\" Style=\"{StaticResource NavButton}\"/>\n                    <Button Content=\"Flight Plan\" Tag=\"FlightPlan\" Click=\"Nav_Click\" Style=\"{StaticResource NavButton}\"/>\n                    <Button Content=\"Airly AI\" Tag=\"AiHelper\" Click=\"Nav_Click\" Style=\"{StaticResource NavButton}\"/>\n                    <TextBlock Text=\"OPERATIONS\" FontSize=\"9\" FontWeight=\"Bold\" Foreground=\"{DynamicResource MutedBrush}\" Margin=\"4,20,0,5\"/>\n                    <Button Content=\"ATC Frequencies\" Tag=\"Frequencies\" Click=\"Nav_Click\" Style=\"{StaticResource NavButton}\"/>\n                    <Button Content=\"Weather / METAR\" Tag=\"Weather\" Click=\"Nav_Click\" Style=\"{StaticResource NavButton}\"/>\n                    <Button Content=\"Charts\" Tag=\"Charts\" Click=\"Nav_Click\" Style=\"{StaticResource NavButton}\"/>\n                    <Button Content=\"Model Matching\" Tag=\"Models\" Click=\"Nav_Click\" Style=\"{StaticResource NavButton}\"/>\n                    <TextBlock Text=\"CLIENT\" FontSize=\"9\" FontWeight=\"Bold\" Foreground=\"{DynamicResource MutedBrush}\" Margin=\"4,20,0,5\"/>\n                    <Button Content=\"Settings\" Tag=\"Settings\" Click=\"Nav_Click\" Style=\"{StaticResource NavButton}\"/>\n                </StackPanel>\n                <StackPanel DockPanel.Dock=\"Bottom\">\n                    <Border Background=\"{DynamicResource GlassBrush}\" BorderBrush=\"{DynamicResource LineBrush}\" BorderThickness=\"1\" CornerRadius=\"8\" Padding=\"10\">\n                        <StackPanel><TextBlock Text=\"NETWORK\" FontSize=\"9\" FontWeight=\"Bold\" Foreground=\"{DynamicResource MutedBrush}\"/><TextBlock x:Name=\"ConnectionLabel\" Text=\"DISCONNECTED\" FontSize=\"12\" FontWeight=\"Bold\" Foreground=\"{DynamicResource DangerBrush}\" Margin=\"0,4,0,0\"/><StackPanel Orientation=\"Horizontal\" Margin=\"0,3,0,0\"><TextBlock x:Name=\"LatencyText\" Text=\"Latency —\" FontSize=\"10\" Foreground=\"{DynamicResource MutedBrush}\"/><TextBlock x:Name=\"FpsText\" Text=\"  •  FPS —\" FontSize=\"10\" Foreground=\"{DynamicResource MutedBrush}\"/></StackPanel></StackPanel>\n                    </Border>\n                    <TextBlock x:Name=\"VersionLabel\" Text=\"Airly Client 0.1\" FontSize=\"10\" Foreground=\"{DynamicResource MutedBrush}\" Margin=\"4,10,0,0\"/>\n                </StackPanel>\n            </DockPanel>\n        </Border>\n\n        <Grid Grid.Column=\"1\" Margin=\"28,22,28,24\">\n            <Grid.RowDefinitions><RowDefinition Height=\"Auto\"/><RowDefinition Height=\"*\"/></Grid.RowDefinitions>\n            <DockPanel>\n                <StackPanel><TextBlock x:Name=\"PageEyebrow\" Text=\"AIRLY NETWORK\" FontSize=\"10\" FontWeight=\"Bold\" Foreground=\"{StaticResource AccentBrush}\"/><TextBlock x:Name=\"PageTitle\" Text=\"Overview\" FontSize=\"28\" FontWeight=\"SemiBold\" Foreground=\"{DynamicResource TextBrush}\" Margin=\"0,3,0,0\"/><TextBlock x:Name=\"PageSubtitle\" Text=\"Flight simulation network operations\" FontSize=\"12\" Foreground=\"{StaticResource MutedBrush}\" Margin=\"0,3,0,0\"/></StackPanel>\n                <StackPanel DockPanel.Dock=\"Right\" Orientation=\"Horizontal\" VerticalAlignment=\"Center\"><Border Background=\"{DynamicResource GlassBrush}\" BorderBrush=\"{DynamicResource LineBrush}\" BorderThickness=\"1\" CornerRadius=\"7\" Padding=\"12,8\" Margin=\"0,0,10,0\"><StackPanel Orientation=\"Horizontal\"><TextBlock x:Name=\"HeaderLatencyText\" Text=\"LATENCY —\" FontSize=\"10\" FontWeight=\"Bold\" Foreground=\"{DynamicResource MutedBrush}\"/><TextBlock x:Name=\"HeaderFpsText\" Text=\"  •  FPS —\" FontSize=\"10\" FontWeight=\"Bold\" Foreground=\"{DynamicResource MutedBrush}\"/></StackPanel></Border><Border Background=\"{DynamicResource GlassBrush}\" BorderBrush=\"{DynamicResource LineBrush}\" BorderThickness=\"1\" CornerRadius=\"7\" Padding=\"12,8\" Margin=\"0,0,10,0\"><TextBlock x:Name=\"TopStatusText\" Text=\"OFFLINE\" FontSize=\"10\" FontWeight=\"Bold\" Foreground=\"{DynamicResource DangerBrush}\"/></Border><Button x:Name=\"ConnectButton\" Content=\"Connect\" Width=\"110\" Height=\"38\" Click=\"Connect_Click\" Style=\"{StaticResource PrimaryButton}\"/></StackPanel>\n            </DockPanel>\n\n            <Grid Grid.Row=\"1\" Margin=\"0,24,0,0\">\n                <Grid x:Name=\"DashboardView\">\n                    <ScrollViewer VerticalScrollBarVisibility=\"Auto\"><StackPanel>\n                        <Grid>\n                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>\n                            <Border Grid.Column=\"0\" Style=\"{StaticResource Card}\" Margin=\"0,0,8,0\"><StackPanel><TextBlock Text=\"NETWORK\" FontSize=\"10\" FontWeight=\"Bold\" Foreground=\"{StaticResource MutedBrush}\"/><TextBlock x:Name=\"NetworkStatus\" Text=\"Offline\" FontSize=\"24\" FontWeight=\"SemiBold\" Margin=\"0,7,0,0\"/><TextBlock Text=\"Airly session\" FontSize=\"10\" Foreground=\"{StaticResource MutedBrush}\" Margin=\"0,3,0,0\"/></StackPanel></Border>\n                            <Border Grid.Column=\"1\" Style=\"{StaticResource Card}\" Margin=\"8,0\"><StackPanel><TextBlock Text=\"AIRCRAFT\" FontSize=\"10\" FontWeight=\"Bold\" Foreground=\"{StaticResource MutedBrush}\"/><TextBlock x:Name=\"TrafficCount\" Text=\"0\" FontSize=\"24\" FontWeight=\"SemiBold\" Margin=\"0,7,0,0\"/><TextBlock Text=\"Airly traffic\" FontSize=\"10\" Foreground=\"{StaticResource MutedBrush}\" Margin=\"0,3,0,0\"/></StackPanel></Border>\n                            <Border Grid.Column=\"2\" Style=\"{StaticResource Card}\" Margin=\"8,0\"><StackPanel><TextBlock Text=\"ATC\" FontSize=\"10\" FontWeight=\"Bold\" Foreground=\"{StaticResource MutedBrush}\"/><TextBlock x:Name=\"ControllerCount\" Text=\"0\" FontSize=\"24\" FontWeight=\"SemiBold\" Margin=\"0,7,0,0\"/><TextBlock Text=\"Active positions\" FontSize=\"10\" Foreground=\"{StaticResource MutedBrush}\" Margin=\"0,3,0,0\"/></StackPanel></Border>\n                            <Border Grid.Column=\"3\" Style=\"{StaticResource Card}\" Margin=\"8,0,0,0\"><StackPanel><TextBlock Text=\"OWN AIRCRAFT\" FontSize=\"10\" FontWeight=\"Bold\" Foreground=\"{StaticResource MutedBrush}\"/><TextBlock x:Name=\"OwnAircraft\" Text=\"Offline\" FontSize=\"24\" FontWeight=\"SemiBold\" Margin=\"0,7,0,0\"/><TextBlock Text=\"Simulator link\" FontSize=\"10\" Foreground=\"{StaticResource MutedBrush}\" Margin=\"0,3,0,0\"/></StackPanel></Border>\n                        </Grid>\n                        <Grid Margin=\"0,16,0,0\">\n                            <Grid.ColumnDefinitions><ColumnDefinition Width=\"1.4*\"/><ColumnDefinition Width=\"*\"/></Grid.ColumnDefinitions>\n                            <Border Grid.Column=\"0\" Style=\"{StaticResource Card}\" Margin=\"0,0,8,0\"><StackPanel><TextBlock Text=\"FLIGHT OPERATIONS\" Style=\"{StaticResource SectionTitle}\"/><TextBlock Text=\"Your imported SimBrief plan and live network state will appear here.\" Foreground=\"{StaticResource MutedBrush}\" Margin=\"0,7,0,18\"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column=\"0\"><TextBlock Text=\"ROUTE\" FontSize=\"9\" FontWeight=\"Bold\" Foreground=\"{StaticResource MutedBrush}\"/><TextBlock x:Name=\"DashboardRoute\" Text=\"—\" FontSize=\"18\" FontWeight=\"SemiBold\" Margin=\"0,5,0,0\"/></StackPanel><StackPanel Grid.Column=\"1\"><TextBlock Text=\"CRUISE\" FontSize=\"9\" FontWeight=\"Bold\" Foreground=\"{StaticResource MutedBrush}\"/><TextBlock x:Name=\"DashboardCruise\" Text=\"—\" FontSize=\"18\" FontWeight=\"SemiBold\" Margin=\"0,5,0,0\"/></StackPanel><StackPanel Grid.Column=\"2\"><TextBlock Text=\"CALLSIGN\" FontSize=\"9\" FontWeight=\"Bold\" Foreground=\"{StaticResource MutedBrush}\"/><TextBlock x:Name=\"DashboardCallsign\" Text=\"—\" FontSize=\"18\" FontWeight=\"SemiBold\" Margin=\"0,5,0,0\"/></StackPanel></Grid></StackPanel></Border>\n                            <Border Grid.Column=\"1\" Style=\"{StaticResource Card}\" Margin=\"8,0,0,0\"><StackPanel><TextBlock Text=\"NETWORK ACTIVITY\" Style=\"{StaticResource SectionTitle}\"/><TextBlock x:Name=\"ActivityText\" Text=\"Connect to Airly to receive live traffic, ATC and network data.\" Foreground=\"{StaticResource MutedBrush}\" TextWrapping=\"Wrap\" Margin=\"0,9,0,0\"/></StackPanel></Border>\n                        </Grid>\n                    </StackPanel></ScrollViewer>\n                </Grid>\n\n                <Grid x:Name=\"ConnectView\" Visibility=\"Collapsed\"><Border Style=\"{StaticResource Card}\"><StackPanel MaxWidth=\"720\"><TextBlock Text=\"Connect to Airly\" Style=\"{StaticResource SectionTitle}\"/><TextBlock Text=\"Choose the simulator you are running and establish the authenticated Airly session.\" Foreground=\"{StaticResource MutedBrush}\" TextWrapping=\"Wrap\" Margin=\"0,7,0,14\"/><TextBlock Text=\"SIMULATOR\" Style=\"{StaticResource FieldLabel}\"/><ComboBox x:Name=\"SimulatorBox\" Height=\"36\" SelectedIndex=\"0\"><ComboBoxItem Content=\"Microsoft Flight Simulator 2024\"/><ComboBoxItem Content=\"Microsoft Flight Simulator 2020\"/><ComboBoxItem Content=\"X-Plane 12\"/><ComboBoxItem Content=\"X-Plane 11\"/></ComboBox><TextBlock Text=\"REGION\" Style=\"{StaticResource FieldLabel}\"/><ComboBox x:Name=\"RegionBox\" Height=\"36\" SelectedIndex=\"0\"><ComboBoxItem Content=\"Europe\"/><ComboBoxItem Content=\"North America\"/><ComboBoxItem Content=\"South America\"/><ComboBoxItem Content=\"Asia-Pacific\"/><ComboBoxItem Content=\"Middle East &amp; Africa\"/></ComboBox><TextBlock Text=\"AIRLY ID\" Style=\"{StaticResource FieldLabel}\"/><TextBox x:Name=\"AirlyIdBox\" Height=\"36\"/><TextBlock Text=\"USERNAME\" Style=\"{StaticResource FieldLabel}\"/><TextBox x:Name=\"UsernameBox\" Height=\"36\"/><StackPanel Orientation=\"Horizontal\" Margin=\"0,20,0,0\"><Button Content=\"Validate &amp; Connect\" Width=\"160\" Height=\"40\" Click=\"Connect_Click\" Style=\"{StaticResource PrimaryButton}\"/><Button Content=\"Disconnect\" Width=\"120\" Height=\"40\" Margin=\"9,0,0,0\" Click=\"Disconnect_Click\" Style=\"{StaticResource SecondaryButton}\"/></StackPanel><TextBlock x:Name=\"ConnectStatus\" Foreground=\"{StaticResource MutedBrush}\" Margin=\"0,14,0,0\" TextWrapping=\"Wrap\"/></StackPanel></Border></Grid>\n\n                <Grid x:Name=\"TrafficView\" Visibility=\"Collapsed\"><Border Style=\"{StaticResource Card}\"><StackPanel><TextBlock Text=\"Live traffic\" Style=\"{StaticResource SectionTitle}\"/><TextBlock Text=\"Airly multiplayer aircraft currently available to the client.\" Foreground=\"{StaticResource MutedBrush}\" Margin=\"0,7,0,14\"/><DataGrid x:Name=\"TrafficGrid\" AutoGenerateColumns=\"False\" IsReadOnly=\"True\" Height=\"520\"><DataGrid.Columns><DataGridTextColumn Header=\"CALLSIGN\" Binding=\"{Binding Callsign}\" Width=\"110\"/><DataGridTextColumn Header=\"AIRCRAFT\" Binding=\"{Binding ModelCode}\" Width=\"100\"/><DataGridTextColumn Header=\"ALTITUDE\" Binding=\"{Binding AltitudeFeet, StringFormat={}{0:N0} ft}\" Width=\"110\"/><DataGridTextColumn Header=\"SPEED\" Binding=\"{Binding GroundSpeedKnots, StringFormat={}{0:N0} kt}\" Width=\"100\"/><DataGridTextColumn Header=\"HEADING\" Binding=\"{Binding HeadingDegrees, StringFormat={}{0:000}°}\" Width=\"100\"/><DataGridTextColumn Header=\"FREQUENCY\" Binding=\"{Binding Frequency}\" Width=\"110\"/></DataGrid.Columns></DataGrid></StackPanel></Border></Grid>\n\n                <Grid x:Name=\"TrackingView\" Visibility=\"Collapsed\">\n                    <Grid><Grid.RowDefinitions><RowDefinition Height=\"Auto\"/><RowDefinition Height=\"*\"/></Grid.RowDefinitions>\n                        <Border Style=\"{StaticResource Card}\"><DockPanel><StackPanel><TextBlock Text=\"Track flights\" Style=\"{StaticResource SectionTitle}\"/><TextBlock Text=\"Search live Airly traffic and inspect flight-plan and aircraft telemetry.\" Foreground=\"{StaticResource MutedBrush}\" Margin=\"0,6,0,0\"/></StackPanel><StackPanel DockPanel.Dock=\"Right\" Orientation=\"Horizontal\" VerticalAlignment=\"Center\"><TextBox x:Name=\"TrackingSearchBox\" Width=\"230\" Height=\"36\" TextChanged=\"TrackingSearch_TextChanged\" ToolTip=\"Callsign, aircraft or route\"/><Button Content=\"Clear\" Width=\"75\" Height=\"36\" Margin=\"8,0,0,0\" Click=\"ClearTracking_Click\" Style=\"{StaticResource SecondaryButton}\"/></StackPanel></DockPanel></Border>\n                        <Grid Grid.Row=\"1\" Margin=\"0,12,0,0\"><Grid.ColumnDefinitions><ColumnDefinition Width=\"1.25*\"/><ColumnDefinition Width=\"*\"/></Grid.ColumnDefinitions>\n                            <Border Grid.Column=\"0\" Style=\"{StaticResource Card}\" Margin=\"0,0,7,0\"><DataGrid x:Name=\"TrackingGrid\" AutoGenerateColumns=\"False\" IsReadOnly=\"True\" SelectionChanged=\"TrackingGrid_SelectionChanged\"><DataGrid.Columns><DataGridTextColumn Header=\"CALLSIGN\" Binding=\"{Binding Callsign}\" Width=\"105\"/><DataGridTextColumn Header=\"AIRCRAFT\" Binding=\"{Binding Aircraft}\" Width=\"95\"/><DataGridTextColumn Header=\"FROM\" Binding=\"{Binding Origin}\" Width=\"75\"/><DataGridTextColumn Header=\"TO\" Binding=\"{Binding Destination}\" Width=\"75\"/><DataGridTextColumn Header=\"ALTITUDE\" Binding=\"{Binding AltitudeFeet, StringFormat={}{0:N0} ft}\" Width=\"100\"/><DataGridTextColumn Header=\"CRUISE\" Binding=\"{Binding CruiseAltitudeFeet, StringFormat={}{0:N0} ft}\" Width=\"100\"/><DataGridTextColumn Header=\"STATUS\" Binding=\"{Binding Status}\" Width=\"100\"/></DataGrid.Columns></DataGrid></Border>\n                            <Border Grid.Column=\"1\" Style=\"{StaticResource Card}\" Margin=\"7,0,0,0\"><ScrollViewer VerticalScrollBarVisibility=\"Auto\"><StackPanel><TextBlock Text=\"AIRCRAFT\" FontSize=\"10\" FontWeight=\"Bold\" Foreground=\"{StaticResource AccentBrush}\"/><TextBlock x:Name=\"TrackCallsign\" Text=\"Select a flight\" FontSize=\"25\" FontWeight=\"SemiBold\" Margin=\"0,4,0,0\"/><TextBlock x:Name=\"TrackAircraft\" Text=\"—\" Foreground=\"{StaticResource MutedBrush}\" Margin=\"0,2,0,14\"/><Border Background=\"{DynamicResource GlassBrush}\" CornerRadius=\"8\" Height=\"180\"><StackPanel VerticalAlignment=\"Center\" HorizontalAlignment=\"Center\"><TextBlock Text=\"JETPHOTOS\" FontSize=\"11\" FontWeight=\"Bold\" Foreground=\"{DynamicResource MutedBrush}\" HorizontalAlignment=\"Center\"/><TextBlock x:Name=\"PhotoStatus\" Text=\"Aircraft photo will load from the Airly JetPhotos service.\" TextAlignment=\"Center\" TextWrapping=\"Wrap\" Width=\"250\" Foreground=\"{StaticResource MutedBrush}\" Margin=\"0,7,0,0\"/><Button x:Name=\"JetPhotosButton\" Content=\"View on JetPhotos\" Click=\"JetPhotos_Click\" Visibility=\"Collapsed\" Margin=\"0,12,0,0\" Style=\"{StaticResource SecondaryButton}\"/></StackPanel></Border><Grid Margin=\"0,16,0,0\"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column=\"0\"><TextBlock Text=\"ROUTE\" FontSize=\"9\" FontWeight=\"Bold\" Foreground=\"{StaticResource MutedBrush}\"/><TextBlock x:Name=\"TrackRoute\" Text=\"—\" FontSize=\"15\" FontWeight=\"SemiBold\" Margin=\"0,4,0,12\"/><TextBlock Text=\"POSITION\" FontSize=\"9\" FontWeight=\"Bold\" Foreground=\"{StaticResource MutedBrush}\"/><TextBlock x:Name=\"TrackPosition\" Text=\"—\" FontSize=\"13\" Margin=\"0,4,0,12\"/><TextBlock Text=\"HEADING\" FontSize=\"9\" FontWeight=\"Bold\" Foreground=\"{StaticResource MutedBrush}\"/><TextBlock x:Name=\"TrackHeading\" Text=\"—\" FontSize=\"13\"/></StackPanel><StackPanel Grid.Column=\"1\"><TextBlock Text=\"LIVE ALTITUDE\" FontSize=\"9\" FontWeight=\"Bold\" Foreground=\"{StaticResource MutedBrush}\"/><TextBlock x:Name=\"TrackAltitude\" Text=\"—\" FontSize=\"15\" FontWeight=\"SemiBold\" Margin=\"0,4,0,12\"/><TextBlock Text=\"CRUISE ALTITUDE\" FontSize=\"9\" FontWeight=\"Bold\" Foreground=\"{StaticResource MutedBrush}\"/><TextBlock x:Name=\"TrackCruise\" Text=\"—\" FontSize=\"15\" FontWeight=\"SemiBold\" Margin=\"0,4,0,12\"/><TextBlock Text=\"GROUND SPEED\" FontSize=\"9\" FontWeight=\"Bold\" Foreground=\"{StaticResource MutedBrush}\"/><TextBlock x:Name=\"TrackSpeed\" Text=\"—\" FontSize=\"13\"/></StackPanel></Grid></StackPanel></ScrollViewer></Border>\n                        </Grid>\n                    </Grid>\n                </Grid>\n\n                <Grid x:Name=\"FrequenciesView\" Visibility=\"Collapsed\"><Border Style=\"{StaticResource Card}\"><StackPanel><TextBlock Text=\"ATC frequencies\" Style=\"{StaticResource SectionTitle}\"/><TextBlock Text=\"Search the worldwide airport frequency dataset. Airly never invents frequencies.\" Foreground=\"{StaticResource MutedBrush}\" TextWrapping=\"Wrap\" Margin=\"0,7,0,10\"/><StackPanel Orientation=\"Horizontal\" Margin=\"0,0,0,10\"><TextBox x:Name=\"FrequencyAirportBox\" Width=\"180\" Height=\"36\" Text=\"EIDW\"/><Button Content=\"Load frequencies\" Width=\"145\" Height=\"36\" Margin=\"8,0,0,0\" Click=\"LoadFrequencies_Click\" Style=\"{StaticResource PrimaryButton}\"/></StackPanel><TextBlock x:Name=\"FrequencyStatus\" Foreground=\"{StaticResource MutedBrush}\" Marg