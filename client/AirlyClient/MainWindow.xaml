<Window x:Class="AirlyClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Airly Client" Width="1320" Height="820"
        MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="#0B1220" Foreground="#E7EEF8">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111B2E"/>
        <SolidColorBrush x:Key="LineBrush" Color="#263750"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8FA2BC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4EA1FF"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#AEBED2"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A2940"/><Setter Property="Foreground" Value="#DDE8F5"/>
            <Setter Property="BorderBrush" Value="#2D405D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F4F8FD"/></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Margin" Value="0,14,0,6"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1728"/><Setter Property="Foreground" Value="#EAF2FC"/><Setter Property="BorderBrush" Value="#2A3D59"/><Setter Property="Padding" Value="10,7"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="#0D1728"/><Setter Property="Foreground" Value="#EAF2FC"/><Setter Property="BorderBrush" Value="#2A3D59"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DDE8F5"/><Setter Property="Margin" Value="0,10,0,0"/></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="#0D1728"/><Setter Property="Foreground" Value="#EAF2FC"/><Setter Property="BorderBrush" Value="#263750"/><Setter Property="RowBackground" Value="#101A2B"/><Setter Property="AlternatingRowBackground" Value="#0D1728"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="FontSize" Value="12"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#18263D"/><Setter Property="Foreground" Value="#AFC1D8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="9,8"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#080F1B" BorderBrush="#1D2A40" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="AIRLY" FontSize="19" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="FLIGHT NETWORK CLIENT" FontSize="9" FontWeight="SemiBold" Foreground="#6F87A4" Margin="0,3,0,22"/>
                    <TextBlock Text="FLIGHT DECK" FontSize="9" FontWeight="Bold" Foreground="#536B89" Margin="4,0,0,5"/>
                    <Button Content="Overview" Tag="Dashboard" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Connect" Tag="Connect" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Traffic" Tag="Traffic" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Track Flights" Tag="Tracking" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Flight Plan" Tag="FlightPlan" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <TextBlock Text="OPERATIONS" FontSize="9" FontWeight="Bold" Foreground="#536B89" Margin="4,20,0,5"/>
                    <Button Content="ATC Frequencies" Tag="Frequencies" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Weather / METAR" Tag="Weather" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Charts" Tag="Charts" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Model Matching" Tag="Models" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <TextBlock Text="CLIENT" FontSize="9" FontWeight="Bold" Foreground="#536B89" Margin="4,20,0,5"/>
                    <Button Content="Settings" Tag="Settings" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#101B2D" BorderBrush="#263750" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel><TextBlock Text="NETWORK" FontSize="9" FontWeight="Bold" Foreground="#6F87A4"/><TextBlock x:Name="ConnectionLabel" Text="DISCONNECTED" FontSize="12" FontWeight="Bold" Foreground="#F18C8C" Margin="0,4,0,0"/><TextBlock x:Name="LatencyText" Text="Latency —" FontSize="10" Foreground="#7F94AF" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                    <TextBlock x:Name="VersionLabel" Text="Airly Client 0.1" FontSize="10" Foreground="#506581" Margin="4,10,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel>
                <StackPanel><TextBlock x:Name="PageEyebrow" Text="AIRLY NETWORK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="PageTitle" Text="Overview" FontSize="28" FontWeight="SemiBold" Foreground="White" Margin="0,3,0,0"/><TextBlock x:Name="PageSubtitle" Text="Flight simulation network operations" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#101B2D" BorderBrush="#263750" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,10,0"><TextBlock x:Name="TopStatusText" Text="OFFLINE" FontSize="10" FontWeight="Bold" Foreground="#F18C8C"/></Border><Button x:Name="ConnectButton" Content="Connect" Width="110" Height="38" Click="Connect_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,24,0,0">
                <Grid x:Name="DashboardView">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="NETWORK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="NetworkStatus" Text="Offline" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Airly session" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0"><StackPanel><TextBlock Text="AIRCRAFT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TrafficCount" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Airly traffic" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0"><StackPanel><TextBlock Text="ATC" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ControllerCount" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Active positions" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="OWN AIRCRAFT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="OwnAircraft" Text="Offline" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Simulator link" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="FLIGHT OPERATIONS" Style="{StaticResource SectionTitle}"/><TextBlock Text="Your imported SimBrief plan and live network state will appear here." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="ROUTE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashboardRoute" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="CRUISE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashboardCruise" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CALLSIGN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashboardCallsign" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="NETWORK ACTIVITY" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ActivityText" Text="Connect to Airly to receive live traffic, ATC and network data." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
                        </Grid>
                    </StackPanel></ScrollViewer>
                </Grid>

                <Grid x:Name="ConnectView" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel MaxWidth="720"><TextBlock Text="Connect to Airly" Style="{StaticResource SectionTitle}"/><TextBlock Text="Choose the simulator you are running and establish the authenticated Airly session." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,14"/><TextBlock Text="SIMULATOR" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SimulatorBox" Height="36" SelectedIndex="0"><ComboBoxItem Content="Microsoft Flight Simulator 2024"/><ComboBoxItem Content="Microsoft Flight Simulator 2020"/><ComboBoxItem Content="X-Plane 12"/><ComboBoxItem Content="X-Plane 11"/></ComboBox><TextBlock Text="REGION" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RegionBox" Height="36" SelectedIndex="0"><ComboBoxItem Content="Europe"/><ComboBoxItem Content="North America"/><ComboBoxItem Content="South America"/><ComboBoxItem Content="Asia-Pacific"/><ComboBoxItem Content="Middle East &amp; Africa"/></ComboBox><TextBlock Text="AIRLY ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AirlyIdBox" Height="36"/><TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UsernameBox" Height="36"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Validate &amp; Connect" Width="160" Height="40" Click="Connect_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Disconnect" Width="120" Height="40" Margin="9,0,0,0" Click="Disconnect_Click" Style="{StaticResource SecondaryButton}"/></StackPanel><TextBlock x:Name="ConnectStatus" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid>

                <Grid x:Name="TrafficView" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Live traffic" Style="{StaticResource SectionTitle}"/><TextBlock Text="Airly multiplayer aircraft currently available to the client." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,14"/><DataGrid x:Name="TrafficGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="520"><DataGrid.Columns><DataGridTextColumn Header="CALLSIGN" Binding="{Binding Callsign}" Width="110"/><DataGridTextColumn Header="AIRCRAFT" Binding="{Binding ModelCode}" Width="100"/><DataGridTextColumn Header="ALTITUDE" Binding="{Binding AltitudeFeet, StringFormat={}{0:N0} ft}" Width="110"/><DataGridTextColumn Header="SPEED" Binding="{Binding GroundSpeedKnots, StringFormat={}{0:N0} kt}" Width="100"/><DataGridTextColumn Header="HEADING" Binding="{Binding HeadingDegrees, StringFormat={}{0:000}°}" Width="100"/><DataGridTextColumn Header="FREQUENCY" Binding="{Binding Frequency}" Width="110"/></DataGrid.Columns></DataGrid></StackPanel></Border></Grid>

                <Grid x:Name="TrackingView" Visibility="Collapsed">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}"><DockPanel><StackPanel><TextBlock Text="Track flights" Style="{StaticResource SectionTitle}"/><TextBlock Text="Search live Airly traffic and inspect flight-plan and aircraft telemetry." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBox x:Name="TrackingSearchBox" Width="230" Height="36" TextChanged="TrackingSearch_TextChanged" ToolTip="Callsign, aircraft or route"/><Button Content="Clear" Width="75" Height="36" Margin="8,0,0,0" Click="ClearTracking_Click" Style="{StaticResource SecondaryButton}"/></StackPanel></DockPanel></Border>
                        <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0"><DataGrid x:Name="TrackingGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="TrackingGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="CALLSIGN" Binding="{Binding Callsign}" Width="105"/><DataGridTextColumn Header="AIRCRAFT" Binding="{Binding Aircraft}" Width="95"/><DataGridTextColumn Header="FROM" Binding="{Binding Origin}" Width="75"/><DataGridTextColumn Header="TO" Binding="{Binding Destination}" Width="75"/><DataGridTextColumn Header="ALTITUDE" Binding="{Binding AltitudeFeet, StringFormat={}{0:N0} ft}" Width="100"/><DataGridTextColumn Header="CRUISE" Binding="{Binding CruiseAltitudeFeet, StringFormat={}{0:N0} ft}" Width="100"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="AIRCRAFT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="TrackCallsign" Text="Select a flight" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock x:Name="TrackAircraft" Text="—" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,14"/><Border Background="#0B1423" CornerRadius="8" Height="180"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="JETPHOTOS" FontSize="11" FontWeight="Bold" Foreground="#6F87A4" HorizontalAlignment="Center"/><TextBlock x:Name="PhotoStatus" Text="Aircraft photo will load from the Airly JetPhotos service." TextAlignment="Center" TextWrapping="Wrap" Width="250" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/><Button x:Name="JetPhotosButton" Content="View on JetPhotos" Click="JetPhotos_Click" Visibility="Collapsed" Margin="0,12,0,0" Style="{StaticResource SecondaryButton}"/></StackPanel></Border><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="ROUTE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TrackRoute" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,12"/><TextBlock Text="POSITION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TrackPosition" Text="—" FontSize="13" Margin="0,4,0,12"/><TextBlock Text="HEADING" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TrackHeading" Text="—" FontSize="13"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="LIVE ALTITUDE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TrackAltitude" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,12"/><TextBlock Text="CRUISE ALTITUDE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TrackCruise" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,12"/><TextBlock Text="GROUND SPEED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TrackSpeed" Text="—" FontSize="13"/></StackPanel></Grid></StackPanel></ScrollViewer></Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="FrequenciesView" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ATC frequencies" Style="{StaticResource SectionTitle}"/><TextBlock Text="Tune a frequency to hear other Airly pilots and controllers on that frequency." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,14"/><DataGrid x:Name="FrequencyGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="500"><DataGrid.Columns><DataGridTextColumn Header="AIRPORT" Binding="{Binding Airport}"/><DataGridTextColumn Header="POSITION" Binding="{Binding Position}"/><DataGridTextColumn Header="FREQUENCY" Binding="{Binding Frequency}"/><DataGridTextColumn Header="CONTROLLER" Binding="{Binding Controller}"/></DataGrid.Columns></DataGrid></StackPanel></Border></Grid>

                <Grid x:Name="WeatherView" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Airport weather / METAR" Style="{StaticResource SectionTitle}"/><StackPanel Orientation="Horizontal" Margin="0,15,0,15"><TextBox x:Name="AirportSearchBox" Width="180" Height="36" Text="EGLL"/><Button Content="Get METAR" Width="120" Height="36" Margin="8,0,0,0" Click="Weather_Click" Style="{StaticResource PrimaryButton}"/></StackPanel><TextBlock x:Name="MetarText" Text="Enter an ICAO code." FontFamily="Consolas" FontSize="14" Foreground="#DDE8F5" TextWrapping="Wrap"/><TextBlock x:Name="WeatherDetails" Foreground="{StaticResource MutedBrush}" Margin="0,15,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid>

                <Grid x:Name="ChartsView" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Charts" Style="{StaticResource SectionTitle}"/><TextBlock Text="Airport diagrams and procedure charts will be loaded from Airly's chart service." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,14"/><TextBox x:Name="ChartAirportBox" Width="180" Height="36" Text="EGLL"/><ListBox x:Name="ChartList" Height="400" Margin="0,15,0,0"/></StackPanel></Border></Grid>

                <Grid x:Name="FlightPlanView" Visibility="Collapsed"><Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel><StackPanel><TextBlock Text="Flight plan" Style="{StaticResource SectionTitle}"/><TextBlock Text="Import your latest SimBrief OFP using the Pilot ID saved in Settings." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Import from SimBrief" Width="165" Height="38" Click="ImportSimBrief_Click" Style="{StaticResource PrimaryButton}"/></DockPanel><Border Background="#0D1728" BorderBrush="#263750" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="CALLSIGN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PlanCallsign" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ROUTE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PlanRoute" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CRUISE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PlanCruise" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Grid></Border><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="FLIGHT" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanAirports" Text="—" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Aircraft" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanAircraft" Text="—"/><TextBlock Text="Registration" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanRegistration" Text="—"/><TextBlock Text="Alternate" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanAlternate" Text="—"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="SCHEDULE" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanTimes" Text="—" FontFamily="Consolas"/><TextBlock Text="AIRAC" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanAirac" Text="—"/><TextBlock Text="ROUTE" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanFullRoute" Text="—" TextWrapping="Wrap"/></StackPanel></Grid><TextBlock x:Name="FlightPlanStatus" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border></Grid>

                <Grid x:Name="ModelsView" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Model matching" Style="{StaticResource SectionTitle}"/><TextBlock Text="Airly receives a versioned aircraft model catalog and maps network aircraft to your simulator packages." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,18"/><TextBlock Text="CATALOG STATUS" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ModelStatus" Text="Ready — server catalog will be loaded after network authentication."/><TextBlock Text="SUPPORTED SIMULATORS" Style="{StaticResource FieldLabel}"/><TextBlock Text="MSFS 2024 • MSFS 2020 • X-Plane 12 • X-Plane 11"/></StackPanel></Border></Grid>

                <Grid x:Name="SettingsView" Visibility="Collapsed"><Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760"><TextBlock Text="Settings" Style="{StaticResource SectionTitle}"/><TextBlock Text="Client preferences are stored locally on this Windows installation." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/><TextBlock Text="SIMBRIEF" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,18,0,0"/><TextBlock Text="Pilot ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SimBriefPilotIdBox" Height="36"/><TextBlock Text="Your SimBrief Pilot ID is used only when you explicitly import a flight plan." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/><TextBlock Text="AIRLY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,22,0,0"/><TextBlock Text="Airly ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SettingsAirlyIdBox" Height="36"/><TextBlock Text="Username" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SettingsUsernameBox" Height="36"/><TextBlock Text="CLIENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,22,0,0"/><CheckBox x:Name="StartWithWindowsBox" Content="Start Airly Client with Windows"/><CheckBox x:Name="AutoConnectBox" Content="Automatically connect to Airly"/><CheckBox x:Name="EnableAtcAudioBox" Content="Enable ATC audio" IsChecked="True"/><CheckBox x:Name="EnableMultiplayerBox" Content="Enable multiplayer traffic" IsChecked="True"/><CheckBox x:Name="AutomaticModelMatchingBox" Content="Use automatic model matching" IsChecked="True"/><Button Content="Save settings" Width="125" Height="38" HorizontalAlignment="Left" Margin="0,20,0,0" Click="SaveSettings_Click" Style="{StaticResource PrimaryButton}"/><TextBlock x:Name="SettingsStatus" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel></ScrollViewer></Border></Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
