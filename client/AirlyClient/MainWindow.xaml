<Window x:Class="AirlyClient.MainWindow" Icon="/AirlyClient;component/Assets/Airly.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Airly Client" Width="1320" Height="820"
        MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" PreviewTextInput="Window_PreviewTextInput">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#0A0D11"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#080B0F"/>
        <SolidColorBrush x:Key="GlassBrush" Color="#12171D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#151B22"/>
        <SolidColorBrush x:Key="InputBrush" Color="#0E1318"/>
        <SolidColorBrush x:Key="LineBrush" Color="#27303A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F5F7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA7B1"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8A96A3"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#26313B"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#62C995"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E68181"/>
        <Style x:Key="NavButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Trigger></Style.Triggers></Style>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.86"/></Trigger></Style.Triggers></Style>
        <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Background" Value="{DynamicResource GlassBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Margin" Value="0,14,0,6"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Padding" Value="10,7"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,10,0,0"/></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="RowBackground" Value="{DynamicResource PanelBrush}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource InputBrush}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="FontSize" Value="12"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource GlassBrush}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="9,8"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="AIRLY" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="FLIGHT NETWORK CLIENT" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,22"/>
                    <TextBlock Text="FLIGHT DECK" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,5"/>
                    <Button Content="Overview" Tag="Dashboard" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Connect" Tag="Connect" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Track Flights" Tag="Tracking" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Flight Plan" Tag="FlightPlan" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Airly AI" Tag="AiHelper" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <TextBlock Text="OPERATIONS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="4,20,0,5"/>
                    <Button Content="ATC Frequencies" Tag="Frequencies" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Weather / METAR" Tag="Weather" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Charts" Tag="Charts" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Model Matching" Tag="Models" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <TextBlock Text="CLIENT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="4,20,0,5"/>
                    <Button Content="Settings" Tag="Settings" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel><TextBlock Text="NETWORK" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ConnectionLabel" Text="DISCONNECTED" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock x:Name="LatencyText" Text="Latency —" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="FpsText" Text="  •  FPS —" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel></StackPanel>
                    </Border>
                    <TextBlock x:Name="VersionLabel" Text="Airly Client 1.0.0" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="4,10,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel>
                <StackPanel><TextBlock x:Name="PageEyebrow" Text="AIRLY NETWORK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="PageTitle" Text="Overview" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,3,0,0"/><TextBlock x:Name="PageSubtitle" Text="Flight simulation network operations" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><TextBlock x:Name="HeaderLatencyText" Text="LATENCY —" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="HeaderFpsText" Text="  •  FPS —" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border><Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,10,0"><TextBlock x:Name="TopStatusText" Text="OFFLINE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/></Border><Button x:Name="ConnectButton" Content="Connect" Width="110" Height="38" Click="Connect_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,24,0,0">
                <Grid x:Name="DashboardView">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="NETWORK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="NetworkStatus" Text="Offline" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Airly session" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0"><StackPanel><TextBlock Text="AIRCRAFT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TrafficCount" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Live tracker" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0"><StackPanel><TextBlock Text="ATC" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ControllerCount" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Network positions" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="OWN AIRCRAFT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="OwnAircraft" Text="Offline" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Simulator link" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                        </Grid>
                        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><DockPanel><StackPanel><TextBlock Text="FLIGHT OPERATIONS" Style="{StaticResource SectionTitle}"/><TextBlock Text="Your current plan, live traffic and network state." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Track live traffic" Tag="Tracking" Click="Nav_Click" Height="34" Style="{StaticResource SecondaryButton}"/></DockPanel><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="ROUTE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashboardRoute" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="CRUISE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashboardCruise" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CALLSIGN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashboardCallsign" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="NETWORK ACTIVITY" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ActivityText" Text="Live aircraft and controller data will appear here." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
                        </Grid>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><DockPanel><StackPanel><TextBlock Text="AIRPORT LOOKUP" Style="{StaticResource SectionTitle}"/><TextBlock Text="Search by ICAO, IATA or airport name." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox x:Name="OverviewAirportBox" IsEditable="True" Width="310" Height="36" DisplayMemberPath="Label"/><Button Content="Search" Width="90" Height="36" Margin="8,0,0,0" Click="OverviewAirportSearch_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></DockPanel><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock x:Name="OverviewAirportName" Text="Search for an airport" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="OverviewAirportMeta" Text="—" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/><TextBlock x:Name="OverviewAirportLocation" Text="—" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/><TextBlock x:Name="OverviewAirportSource" Text="Source: Airly / OurAirports" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0"><TextBlock Text="GROUND" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="OverviewAirportGround" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="ELEVATION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/><TextBlock x:Name="OverviewAirportElevation" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="ATC STATUS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="OverviewAirportAtc" Text="No airport-specific position reported" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="OTHER FREQUENCIES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/><ItemsControl x:Name="OverviewAirportFrequencies" Margin="0,4,0,0"/></StackPanel></Grid></StackPanel></Border>
                        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="LIVE TRACKER" Style="{StaticResource SectionTitle}"/><TextBlock Text="Aircraft positions update automatically." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/><TextBlock Text="Use Track Flights for the full 2D map." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0"><StackPanel><TextBlock Text="WEATHER" Style="{StaticResource SectionTitle}"/><TextBlock Text="METAR and TAF tools remain available under Operations." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="SIMBRIEF" Style="{StaticResource SectionTitle}"/><TextBlock Text="Import a plan from Flight Plan when you are ready." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border></Grid>
                    </StackPanel></ScrollViewer>
                </Grid>

                <Grid x:Name="ConnectView" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel MaxWidth="720"><TextBlock Text="Connect to Airly" Style="{StaticResource SectionTitle}"/><TextBlock Text="Choose the simulator you are running and establish the authenticated Airly session." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,14"/><TextBlock Text="SIMULATOR" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SimulatorBox" Height="36" SelectedIndex="0"><ComboBoxItem Content="Microsoft Flight Simulator 2024"/><ComboBoxItem Content="Microsoft Flight Simulator 2020"/><ComboBoxItem Content="X-Plane 12"/><ComboBoxItem Content="X-Plane 11"/></ComboBox><TextBlock Text="REGION" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RegionBox" Height="36" SelectedIndex="0"><ComboBoxItem Content="Europe"/><ComboBoxItem Content="North America"/><ComboBoxItem Content="South America"/><ComboBoxItem Content="Asia-Pacific"/><ComboBoxItem Content="Middle East &amp; Africa"/></ComboBox><TextBlock Text="AIRLY ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AirlyIdBox" Height="36"/><TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UsernameBox" Height="36"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Validate &amp; Connect" Width="160" Height="40" Click="Connect_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Disconnect" Width="120" Height="40" Margin="9,0,0,0" Click="Disconnect_Click" Style="{StaticResource SecondaryButton}"/></StackPanel><TextBlock x:Name="ConnectStatus" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid>

                <Grid x:Name="TrackingView" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}"><DockPanel><StackPanel><TextBlock Text="Track flights" Style="{StaticResource SectionTitle}"/><TextBlock Text="Live 2D aircraft tracking with satellite imagery." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBox x:Name="TrackingSearchBox" Width="250" Height="36" TextChanged="TrackingSearch_TextChanged" ToolTip="Callsign, country, aircraft or route"/><Button Content="Clear" Width="75" Height="36" Margin="8,0,0,0" Click="ClearTracking_Click" Style="{StaticResource SecondaryButton}"/></StackPanel></DockPanel></Border>
                    <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,7,0"><wv2:WebView2 x:Name="TrackingMap" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border>
                        <Grid Grid.Column="1" Margin="7,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel><TextBlock Text="SELECTED FLIGHT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="TrackCallsign" Text="Select a flight" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="TrackAircraft" Text="—" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="ALTITUDE" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TrackAltitude" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,9"/><TextBlock Text="SPEED" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TrackSpeed" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,9"/><TextBlock Text="HEADING" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TrackHeading" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ROUTE" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TrackRoute" Text="—" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,9"/><TextBlock Text="POSITION" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TrackPosition" Text="—" FontSize="12" Margin="0,3,0,9"/><TextBlock Text="CRUISE" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TrackCruise" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid><Button x:Name="JetPhotosButton" Content="View aircraft photos" Click="JetPhotos_Click" Visibility="Collapsed" Margin="0,14,0,0" Style="{StaticResource SecondaryButton}"/><TextBlock x:Name="PhotoStatus" Text="Select an aircraft to inspect it." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,0"/></StackPanel></Border>
                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="TrackingGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="TrackingGrid_SelectionChanged" CanUserReorderColumns="False" CanUserResizeColumns="False"><DataGrid.Columns><DataGridTextColumn Header="CALLSIGN" Binding="{Binding Callsign}" Width="105"/><DataGridTextColumn Header="COUNTRY" Binding="{Binding Country}" Width="90"/><DataGridTextColumn Header="ALT" Binding="{Binding AltitudeFeet, StringFormat={}{0:N0} ft}" Width="95"/><DataGridTextColumn Header="SPEED" Binding="{Binding GroundSpeedKnots, StringFormat={}{0:N0} kt}" Width="90"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="95"/></DataGrid.Columns></DataGrid></Border>
                        </Grid></Grid>
                </Grid>

                <Grid x:Name="FrequenciesView" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ATC frequencies" Style="{StaticResource SectionTitle}"/><TextBlock Text="Search the worldwide airport frequency dataset. Airly never invents frequencies." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,10"/><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBox x:Name="FrequencyAirportBox" Width="180" Height="36" Text="EIDW"/><Button Content="Load frequencies" Width="145" Height="36" Margin="8,0,0,0" Click="LoadFrequencies_Click" Style="{StaticResource PrimaryButton}"/></StackPanel><TextBlock x:Name="FrequencyStatus" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/><DataGrid x:Name="FrequencyGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="450"><DataGrid.Columns><DataGridTextColumn Header="AIRPORT" Binding="{Binding Airport}"/><DataGridTextColumn Header="POSITION" Binding="{Binding Position}"/><DataGridTextColumn Header="FREQUENCY" Binding="{Binding Frequency}"/><DataGridTextColumn Header="CONTROLLER" Binding="{Binding Controller}"/></DataGrid.Columns></DataGrid></StackPanel></Border></Grid>

                <Grid x:Name="WeatherView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <DockPanel><StackPanel><TextBlock Text="Airport weather / METAR" Style="{StaticResource SectionTitle}"/><TextBlock Text="Decoded operational weather from AviationWeather.gov, presented as pilot-readable data." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBox x:Name="AirportSearchBox" Width="150" Height="36" Text="EGLL"/><Button Content="Refresh" Width="105" Height="36" Margin="8,0,0,0" Click="Weather_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></DockPanel>
                            <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="STATION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="WeatherStation" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="WeatherName" Text="—" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0"><StackPanel><TextBlock Text="FLIGHT CATEGORY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="WeatherCategory" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="WeatherObserved" Text="—" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0"><StackPanel><TextBlock Text="WIND" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="WeatherWind" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="true direction / knots" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                                <Border Grid.Column="3" Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="VISIBILITY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="WeatherVisibility" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="statute miles" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                            </Grid>
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="TEMPERATURE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="WeatherTemperature" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0"><StackPanel><TextBlock Text="DEW POINT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="WeatherDewpoint" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0"><StackPanel><TextBlock Text="ALTIMETER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="WeatherPressure" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                                <Border Grid.Column="3" Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="CLOUDS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="WeatherClouds" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            </Grid>
                            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0"><StackPanel>
                                <TextBlock Text="PRESENT WEATHER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="WeatherPhenomena" Text="—" FontSize="15" Margin="0,5,0,12"/>
                                <TextBlock Text="RAW METAR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MetarText" Text="Enter an ICAO code." FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock x:Name="WeatherDetails" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            </StackPanel></Border>
                        </StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </Grid>

                <Grid x:Name="ChartsView" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel>
                    <DockPanel><StackPanel><TextBlock Text="Charts" Style="{StaticResource SectionTitle}"/><TextBlock Text="Open verified chart providers for the airport. Worldwide coverage uses ChartFox when an official source is not configured." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBox x:Name="ChartAirportBox" Width="150" Height="36" Text="EIDW"/><Button Content="Search" Width="105" Height="36" Margin="8,0,0,0" Click="LoadCharts_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></DockPanel>
                    <TextBlock x:Name="ChartStatus" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                    <ListBox x:Name="ChartList" Height="470" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate>
                        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding Provider}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Coverage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding Url}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                            <Button Grid.Column="1" Content="Open" Width="80" Height="34" Margin="14,0,0,0" Tag="{Binding Url}" Click="ChartOpen_Click" Style="{StaticResource SecondaryButton}"/>
                        </Grid></Border>
                    </DataTemplate></ListBox.ItemTemplate></ListBox>
                </StackPanel></Border></Grid>

                <Grid x:Name="FlightPlanView" Visibility="Collapsed"><Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel><StackPanel><TextBlock Text="Flight plan" Style="{StaticResource SectionTitle}"/><TextBlock Text="Import your latest SimBrief OFP using the Pilot ID saved in Settings." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Import from SimBrief" Width="165" Height="38" Click="ImportSimBrief_Click" Style="{StaticResource PrimaryButton}"/></DockPanel><Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="CALLSIGN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PlanCallsign" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ROUTE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PlanRoute" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CRUISE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PlanCruise" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Grid></Border><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="FLIGHT" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanAirports" Text="—" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Aircraft" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanAircraft" Text="—"/><TextBlock Text="Registration" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanRegistration" Text="—"/><TextBlock Text="Alternate" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanAlternate" Text="—"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="SCHEDULE" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanTimes" Text="—" FontFamily="Consolas"/><TextBlock Text="AIRAC" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanAirac" Text="—"/><TextBlock Text="ROUTE" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PlanFullRoute" Text="—" TextWrapping="Wrap"/></StackPanel></Grid><TextBlock x:Name="FlightPlanStatus" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border></Grid>

                <Grid x:Name="ModelsView" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Model matching" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Install a real MSFS traffic model package directly into your Community folder. Airly detects standard Steam and Microsoft Store/Xbox App locations and supports custom folders." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,18"/>
                        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel>
                            <DockPanel><StackPanel><TextBlock Text="FSLTL TRAFFIC BASE MODELS" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Free third-party MSFS traffic models and liveries used for model matching." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="MSFS 2020 / 2024" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/></DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="ModelInstallButton" Content="Install" Width="110" Height="38" Click="InstallModels_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Choose Community" Width="145" Height="38" Margin="8,0,0,0" Click="ChooseCommunity_Click" Style="{StaticResource SecondaryButton}"/><Button Content="Open Folder" Width="110" Height="38" Margin="8,0,0,0" Click="OpenCommunity_Click" Style="{StaticResource SecondaryButton}"/></StackPanel>
                            <TextBlock Text="COMMUNITY FOLDER" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ModelCommunityPath" Text="Searching for an MSFS Community folder…" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="ModelProgressBar" Height="6" Margin="0,12,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/><TextBlock x:Name="ModelProgressText" Text="" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel></Border>
                        <TextBlock x:Name="ModelStatus" Text="Ready to install model-matching packages." Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Airly installs only into the selected Community folder. It does not modify MSFS core files." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer></Grid>

                <Grid x:Name="AiHelperView" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="4,0,0,14"><TextBlock Text="AIRLY AI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Aviation assistant" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="Ask about flight planning, ATC, aircraft, weather, navigation or aviation calculations." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource WindowBrush}"><ScrollViewer x:Name="AiScroll" VerticalScrollBarVisibility="Auto" Padding="4,0,12,8"><StackPanel x:Name="AiMessages" MaxWidth="860" HorizontalAlignment="Center"/></ScrollViewer></Border>
                    <Border Grid.Row="2" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="8" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="😊" Tag="😊" Click="AiEmoji_Click" Width="34" Height="34" Style="{StaticResource SecondaryButton}" BorderThickness="0"/><Button Grid.Column="1" Content="＋" Click="AiFile_Click" Width="34" Height="34" Style="{StaticResource SecondaryButton}" BorderThickness="0"/><TextBox Grid.Column="2" x:Name="AiInput" BorderThickness="0" Background="Transparent" MinHeight="38" MaxHeight="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8,8" ToolTip="Message Airly AI" KeyDown="AiInput_KeyDown"/><ComboBox Grid.Column="3" x:Name="AiPowerBox" Height="34" Margin="6,0,4,0" SelectedIndex="1" SelectionChanged="AiPower_SelectionChanged"><ComboBoxItem Content="Minimal"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Extra"/></ComboBox><Button Grid.Column="4" Content="↑" Click="AiAsk_Click" Width="36" Height="36" Style="{StaticResource PrimaryButton}" ToolTip="Send"/></Grid></Border>
                    <TextBlock x:Name="AiAttachment" Text="No attachment" Grid.Row="2" Visibility="Collapsed"/><TextBlock x:Name="AiStatusText" Text="Ready" Grid.Row="2" HorizontalAlignment="Right" Margin="0,-18,55,0" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                </Grid></Grid>

                <Grid x:Name="SettingsView" Visibility="Collapsed"><Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760"><TextBlock Text="Settings" Style="{StaticResource SectionTitle}"/><TextBlock Text="Client preferences are stored locally on this Windows installation." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/><TextBlock Text="SIMBRIEF" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,18,0,0"/><TextBlock Text="Pilot ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SimBriefPilotIdBox" Height="36"/><TextBlock Text="Your SimBrief Pilot ID is used only when you explicitly import a flight plan." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/><TextBlock Text="AIRLY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,22,0,0"/><TextBlock Text="Airly ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SettingsAirlyIdBox" Height="36"/><TextBlock Text="Username" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SettingsUsernameBox" Height="36"/><TextBlock Text="CLIENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,22,0,0"/><CheckBox x:Name="StartWithWindowsBox" Content="Start Airly Client with Windows"/><CheckBox x:Name="AutoConnectBox" Content="Automatically connect to Airly"/><CheckBox x:Name="EnableAtcAudioBox" Content="Enable ATC audio" IsChecked="True"/><CheckBox x:Name="EnableMultiplayerBox" Content="Enable multiplayer traffic" IsChecked="True"/><CheckBox x:Name="AutomaticModelMatchingBox" Content="Use automatic model matching" IsChecked="True"/><TextBlock Text="APPEARANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,24,0,0"/>
<TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/>
<ComboBox x:Name="ThemeModeBox" Height="36" SelectionChanged="ThemeModeBox_SelectionChanged">
    <ComboBoxItem Content="Dark"/>
    <ComboBoxItem Content="Bright"/>
</ComboBox>
<TextBlock Text="Color palette" Style="{StaticResource FieldLabel}"/>
<ComboBox x:Name="AccentColorBox" Height="36" SelectionChanged="AccentColorBox_SelectionChanged"/>
<TextBlock Text="Palette options change with the selected theme. Default keeps the neutral system treatment." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
<Button Content="Save settings" Width="125" Height="38" HorizontalAlignment="Left" Margin="0,20,0,0" Click="SaveSettings_Click" Style="{StaticResource PrimaryButton}"/><TextBlock x:Name="SettingsStatus" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel></ScrollViewer></Border></Grid>
            </Grid>
        </Grid>
        <Border x:Name="UpdateOverlay" Grid.ColumnSpan="2" Width="390" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,22,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Visibility="Collapsed" Panel.ZIndex="50"><Border.RenderTransform><TranslateTransform x:Name="UpdateOverlayTransform" X="430"/></Border.RenderTransform><StackPanel><TextBlock Text="AIRLY UPDATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="UpdateTitle" Text="Airly Update" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock x:Name="UpdateVersion" Text="Version 1.0.0" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/><TextBlock x:Name="UpdateNotes" Text="A new version is available." TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Margin="0,16,0,0"/><TextBlock x:Name="UpdateMandatoryText" Text="You can postpone this update for up to 7 days." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button x:Name="UpdateCancelButton" Content="Cancel" Width="86" Height="36" Click="UpdateCancel_Click" Style="{StaticResource SecondaryButton}"/><Button x:Name="UpdateNowButton" Content="Update now" Width="112" Height="36" Margin="8,0,0,0" Click="UpdateNow_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></StackPanel></Border>
    </Grid>
</Window>
