<Window x:Class="AirlyClient.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Airly Client" Width="760" Height="500" WindowStartupLocation="CenterScreen" Background="#F3F5F7">
<Grid Margin="42"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="AIRLY" FontSize="15" FontWeight="SemiBold" Foreground="#52606D"/><TextBlock Text="Network Client" FontSize="34" FontWeight="SemiBold" Foreground="#102A43" Margin="0,5,0,0"/><TextBlock Text="Connect your simulator to the Airly network." FontSize="15" Foreground="#627D98" Margin="0,8,0,0"/></StackPanel>
<Border Grid.Row="1" Background="White" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="10" Padding="28" Margin="0,28,0,20"><StackPanel><TextBlock Text="Network connection" FontSize="20" FontWeight="SemiBold" Foreground="#102A43"/>
<TextBlock Text="Region" Margin="0,22,0,6" Foreground="#486581"/><ComboBox x:Name="RegionBox" SelectedIndex="0" Height="36"><ComboBoxItem Content="Europe"/><ComboBoxItem Content="North America"/><ComboBoxItem Content="South America"/><ComboBoxItem Content="Asia-Pacific"/><ComboBoxItem Content="Middle East &amp; Africa"/></ComboBox>
<TextBlock Text="Airly ID" Margin="0,18,0,6" Foreground="#486581"/><TextBox x:Name="AirlyIdBox" Height="36" Padding="8"/>
<TextBlock Text="Username" Margin="0,18,0,6" Foreground="#486581"/><TextBox x:Name="UsernameBox" Height="36" Padding="8" IsEnabled="False"/>
<TextBlock x:Name="StatusText" Text="Enter the Airly ID from your acceptance email." Foreground="#627D98" Margin="0,18,0,0" TextWrapping="Wrap"/></StackPanel></Border>
<Button Grid.Row="2" x:Name="ActionButton" Content="Validate ID" Width="170" Height="42" HorizontalAlignment="Right" Click="ActionButton_Click"/></Grid></Window>
